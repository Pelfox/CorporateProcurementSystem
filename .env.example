# Copy values into your shell or IDE environment; Spring Boot does not load .env automatically.
# Docker Compose reads .env. Set an individual local password before starting it.
POSTGRES_USER=cps_dev
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5433/corporate_procurement_auth_dev
BCRYPT_STRENGTH=12
TEMPORARY_PASSWORD_TTL=PT24H
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=
JWT_ISSUER=corporate-procurement-system
JWT_AUDIENCE=cps-web
ACCESS_TOKEN_TTL=PT10M
PASSWORD_CHANGE_TOKEN_TTL=PT5M
AUTH_SESSION_TTL=P7D
AUTH_HISTORY_RETENTION=P1D
WEB_ALLOWED_ORIGINS=http://localhost:5173

# Explicit one-time offline provisioning. No shared password; supply a unique temporary secret in your shell.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=

# postgresTest must point to a separate disposable test database, never the dev database.
POSTGRES_TEST_URL=
POSTGRES_TEST_USER=cps_test
POSTGRES_TEST_PASSWORD=
