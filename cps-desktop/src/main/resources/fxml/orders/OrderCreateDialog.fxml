<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/25"
           fx:controller="com.team.corporate.desktop.controllers.modals.OrderEditorController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form-wide" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Заказ" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" onAction="#onCancelClick" text="✕" styleClass="dialog-close"/>
        </HBox>

        <Label fx:id="warningLabel" text="Редактирование доступно только для созданного заказа" visible="false"
               managed="false" wrapText="true"/>

        <!-- Добавить товар -->
        <VBox styleClass="form-group">
            <Label text="Добавить товар" styleClass="form-label"/>
            <HBox styleClass="dialog-add-row">
                <ComboBox fx:id="productCombo" styleClass="form-select"
                          promptText="— Выберите товар —"
                          maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="quantityField" styleClass="dialog-qty-field"
                           promptText="Кол-во"/>
                <Button fx:id="addItemBtn" onAction="#onAddClick" text="+"
                        styleClass="btn-add-icon"/>
            </HBox>
            <Label fx:id="addItemError"
                   text="Выберите товар и укажите количество от 1"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Таблица позиций -->
        <VBox styleClass="form-group">
            <Label text="Позиции заказа" styleClass="form-label"/>
            <TableView fx:id="itemsTable" styleClass="dialog-items-table">
                <placeholder>
                    <Label text="Позиции не добавлены" styleClass="table-placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="productCol" text="Товар" prefWidth="300"/>
                    <TableColumn fx:id="quantityCol" text="Кол-во" prefWidth="100"/>
                    <TableColumn fx:id="sumCol" text="Сумма" prefWidth="140"/>
                    <TableColumn fx:id="removeCol" text="" prefWidth="60"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Итого -->
        <HBox styleClass="dialog-total-row">
            <Label fx:id="totalLabel" text="Итого: 0,00 ₽"
                   styleClass="dialog-total-label"/>
        </HBox>

        <!-- Примечание -->
        <VBox styleClass="form-group">
            <Label text="Примечание" styleClass="form-label"/>
            <TextArea fx:id="notesArea" styleClass="form-textarea"
                      promptText="Необязательное примечание к заказу"
                      prefRowCount="2" wrapText="true"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" onAction="#onCancelClick" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="createBtn" onAction="#onSaveClick" text="Создать заказ" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>