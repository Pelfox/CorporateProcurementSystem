<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/25"
           fx:controller="com.team.corporate.desktop.controllers.modals.ErrorController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox fx:id="dialogRoot"
          styleClass="dialog-root">

        <Label fx:id="errorEmoji" styleClass="dialog-emoji" maxWidth="Infinity"/>

        <Label text="Ошибка"
               styleClass="dialog-title-plain, error"
               maxWidth="Infinity" alignment="CENTER"
               textAlignment="CENTER"/>

        <Label fx:id="errorText"
               text="Произошла неизвестная ошибка."
               styleClass="dialog-info-box, error"
               maxWidth="Infinity"
               wrapText="true"/>

        <HBox styleClass="dialog-actions, centered">
            <Button fx:id="okBtn" onAction="#onCloseClick" text="Понятно"
                    styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>
