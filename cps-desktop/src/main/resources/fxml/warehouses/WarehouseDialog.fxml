<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/25"
           fx:controller="com.team.corporate.desktop.controllers.modals.WarehouseEditorController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Склад" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" onAction="#onCancelClick" text="✕" styleClass="dialog-close"/>
        </HBox>

        <!-- Название склада -->
        <VBox styleClass="form-group">
            <Label text="Название склада *" styleClass="form-label"/>
            <TextField fx:id="nameField" styleClass="form-input"
                       promptText="Название склада — не более 255 символов"/>
            <Label fx:id="nameLengthLabel" styleClass="form-label"/>
            <Label fx:id="nameError"
                   text="Название склада не может быть пустым"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Адрес -->
        <VBox styleClass="form-group">
            <Label text="Адрес (местоположение)" styleClass="form-label"/>
            <TextField fx:id="locationField" styleClass="form-input"
                       promptText="Адрес — не более 255 символов"/>
            <Label fx:id="locationLengthLabel" styleClass="form-label"/>
            <Label fx:id="locationError" styleClass="form-error" visible="false" managed="false"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" onAction="#onCancelClick" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="saveBtn" onAction="#onSaveClick" text="Сохранить" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>
